{
  "compilerOptions": {
    "target": "ES2020",
    "lib": ["ES2020", "DOM", "DOM.Iterable"],

    /* The viewer is loaded with a plain <script> tag and publishes itself as
       window.PictureViewer. That means no modules: `module: none` makes tsc
       treat every file as a global script and concatenate them into one
       output file. */
    "module": "none",
    "outFile": "viewer.js",

    /* This is browser code only. Without this, tsc walks up the tree and pulls
       in @types/node that the Electron shell at the repo root installed, which
       then fails to resolve undici-types and buries our own errors. */
    "types": [],

    "strict": true,
    "noImplicitOverride": true,
    "noFallthroughCasesInSwitch": true,
    "forceConsistentCasingInFileNames": true,

    /* Keep the comments; the build must not eat them. */
    "removeComments": false,
    "newLine": "lf",
    "sourceMap": false,
    "declaration": false
  },
  "include": ["src/**/*.ts"]
}
